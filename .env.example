# 複製為 .env，再填入自己的設定。勿將 .env 提交到 Git。
ADMIN_PASSWORD=
PUBLISH_PORT=3737
BIND_ADDRESS=0.0.0.0
TZ=Asia/Taipei
ALLOW_ANONYMOUS_FALLBACK=true
ALLOW_OPEN_WHEN_NO_KEYS=true
UPSTREAM_TIMEOUT_MS=180000
UPSTREAM_LANGUAGE=zh-hans
MAX_LOG_ENTRIES=500
ADMIN_SESSION_TTL_HOURS=12
BROWSER_LOGIN_ENABLED=true
BROWSER_LOGIN_ALLOW_PRIVATE_HTTP=true
# 使用受信任的自訂區網 DNS 名稱時，填寫面板的完整 HTTP origin（含非預設埠）。
# BROWSER_LOGIN_PRIVATE_HTTP_ORIGIN=http://ai.lan:3737
BROWSER_LOGIN_TTL_SECONDS=600
BROWSER_LOGIN_MAX_SESSIONS=2
# 本機 npm start 才需指定（留空會自動尋找 Chrome / Edge / Chromium）。
# BROWSER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# 使用預建映像時可指定版本或 sha 標籤。
IMAGE=ghcr.io/nka551774-hue/deepai2api:latest
# UPSTREAM_KEYS=key1,key2
# ACCOUNT_COOKIES='sessionid=first; csrftoken=example'
