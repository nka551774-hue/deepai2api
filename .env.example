# 複製為 .env，再填入自己的設定。勿將 .env 提交到 Git。
ADMIN_PASSWORD=change-this-password
PUBLISH_PORT=3737
BIND_ADDRESS=0.0.0.0
TZ=Asia/Taipei
ALLOW_ANONYMOUS_FALLBACK=true
ALLOW_OPEN_WHEN_NO_KEYS=true
UPSTREAM_TIMEOUT_MS=180000
UPSTREAM_LANGUAGE=zh-hans
MAX_LOG_ENTRIES=500
ADMIN_SESSION_TTL_HOURS=12

# 使用預建映像時可指定版本或 sha 標籤。
IMAGE=ghcr.io/nka551774-hue/deepai2api:latest
# UPSTREAM_KEYS=key1,key2
# ACCOUNT_COOKIES='sessionid=first; csrftoken=example'
