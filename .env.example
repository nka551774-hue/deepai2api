# 管理面板密碼
ADMIN_PASSWORD=deepai2api

# 服務埠
PORT=3737

# 資料目錄(狀態檔放這裡)
DATA_DIR=./data

# 池內 key 耗盡時自動改用匿名單次 tryit key(true/false)
ALLOW_ANONYMOUS_FALLBACK=true

# 未簽發 API 金鑰前是否開放 API(true/false)
ALLOW_OPEN_WHEN_NO_KEYS=true

# 上游單次請求超時(毫秒)
UPSTREAM_TIMEOUT_MS=180000

# 開機時直接匯入上游 key(逗號分隔,選填)
# UPSTREAM_KEYS=key1,key2
